// Optional per-developer overrides. Copy to Config/Secrets.xcconfig (git-ignored).
// The project's real identity belongs in Identity.xcconfig; use this file only for
// local differences (e.g. building to your own device with a personal team).
//
// IMPORTANT: xcconfig values are compiled into Info.plist and are readable by anyone who
// downloads the app. Only identifiers belong here. Real secrets — LLM provider API keys,
// App Store Server API keys — must live on a server and never ship in the app.

// DEVELOPMENT_TEAM = <your 10-character Team ID>
// PL_BUNDLE_ID_PREFIX = <a reverse-DNS prefix you own>

// App Store Connect subscription group ID (enables Product.SubscriptionInfo.status lookups).
// PL_SUBSCRIPTION_GROUP_ID = 21234567

// Public base URL of a FUTURE assistant proxy. Must stay empty in this release: the app
// has no networking, the privacy policy says so, and the release gate rejects a value.
// "//" starts a comment in xcconfig, so escape it as "/$()/":
// PL_ASSISTANT_ENDPOINT = https:/$()/assistant.example.com

// Public support and privacy-policy pages, once deployed (see website/README.md).
// PL_SUPPORT_URL = https:/$()/<your-domain>/support.html
// PL_PRIVACY_POLICY_URL = https:/$()/<your-domain>/privacy.html
